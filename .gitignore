# ---- dependencies / build output ----
node_modules/
**/node_modules/
dist/
**/dist/
*.tsbuildinfo

# ---- caches / logs / temp ----
.cache/
**/.cache/
__pycache__/
**/__pycache__/
*.pyc
*.log
.npm/
.npm-global/
.DS_Store

# ---- terraform (keep *.tf source; drop plugins + state + secrets) ----
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# ---- generated / large media in prototypes (regenerated by the gen scripts) ----
volt-frame-proto/media/*.ts
volt-frame-proto/media/*.mp4
volt-image-proto/media/
volt-image-proto/.cache/

# ---- session artifacts (screenshots, zips, scratch) ----
*.zip
volt_frame_scrub.png
volt_image_gallery.png
volt_share_page.png

# ---- env / secrets ----
.env
*.env
!*.example.env
