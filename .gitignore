# ---- dependencies / build output ----
node_modules/
**/node_modules/
dist/
**/dist/
*.tsbuildinfo

# ---- caches / logs / temp ----
.cache/
**/.cache/
__pycache__/
**/__pycache__/
*.pyc
*.log
.npm/
.npm-global/
.DS_Store

# ---- terraform (keep *.tf source; drop plugins + state + secrets) ----
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# ---- generated / large media in prototypes (regenerated by the gen scripts) ----
volt-frame-proto/media/*.ts
volt-frame-proto/media/*.mp4
volt-image-proto/media/
volt-image-proto/.cache/

# ---- session artifacts (screenshots, zips, scratch) ----
*.zip
volt_frame_scrub.png
volt_image_gallery.png
volt_share_page.png

# ---- env / secrets ----
.env
*.env
!*.example.env

# ---- local sync helpers (per-machine, not part of the project) ----
publish.sh
*.bundle

# test-stream generated origin (HLS/DASH/VTT)
volt-app/origin/
origin/

# ---- local encoder run harness (per-machine: output + auto-downloaded Shaka) ----
volt-encoder/_local_out/
volt-encoder/.bin/

volt-app/origin/_control-plane.log

# ---- caption sync test harness (fetched / generated, not source) ----
volt-encoder/bin/hls.min.js
volt-encoder/_synctest/
volt-encoder/dev/_wftest/

# ---- runtime data written by a running stack or session (not source) ----
volt-app/clips/
volt-app/filler/
volt-app/image-store/derived/
volt-app/image-store/library/
volt-app/image-store/cache/
volt-app/.env.bak.*
*.timestamp-*.mjs
/outputs
/_*.tgz
/_to_delete/
