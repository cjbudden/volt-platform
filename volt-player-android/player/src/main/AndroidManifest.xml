<?xml version="1.0" encoding="utf-8"?>
<!--
  The Volt player SDK. Merged into the app's manifest:
  - INTERNET for the play gate and the stream.
  - The playback service, used only when the app turns on background playback
    (VoltPlayerOptions.backgroundPlayback): it keeps radio and audio playing with
    the screen off and shows the system media notification and lock screen controls.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Add to calendar: the event's .ics handed to the viewer's calendar app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.volt.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/volt_file_paths" />
        </provider>
        <service
            android:name="com.volt.player.VoltPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
