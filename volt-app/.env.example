# --- Volt control plane config ---
NODE_ENV=development
PORT=8080

# Postgres (RDS in prod). docker-compose sets these for local.
DATABASE_URL=postgres://volt:volt@localhost:5432/volt

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TTL=900          # 15 min (seconds)
REFRESH_TTL=1209600     # 14 days (seconds)

# AWS / delivery
AWS_REGION=ap-southeast-1
S3_BUCKET=ols-origin-dev
CDN_BASE_URL=https://cdn.example.com

# CORS
CORS_ORIGIN=http://localhost:5173
