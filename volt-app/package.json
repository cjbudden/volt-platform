{
  "name": "volt-control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "Volt Streaming — OTT livestreaming platform. Control-plane API (auth, accounts, channels, events, output profiles, instances, VOD).",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node scripts/migrate.js",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.js",
    "test:ingest": "bash test/ingest.sh",
    "seed:access": "tsx scripts/seed-access.ts",
    "seed:fast-user": "tsx scripts/seed-fast-user.ts",
    "test:access": "tsx test/access/access-check.ts",
    "test:identity": "tsx test/identity/identity-check.ts",
    "docs:routes": "tsx scripts/api-routes.ts",
    "docs:openapi": "node scripts/openapi.mjs",
    "api:capture": "bash api/capture_api.sh",
    "api:verify": "bash api/verify.sh",
    "test:images": "tsx test/images.check.ts",
    "test:graphics": "tsx test/graphics-pure.check.ts",
    "test:genres": "tsx test/metadata-lists.check.ts",
    "test:graphics:db": "tsx test/graphics.check.ts",
    "test:graphics:player": "tsx test/player-overlay.check.ts",
    "test:images:api": "bash test/images-api.check.sh",
    "test:images:s3": "tsx test/images-s3.check.ts",
    "images:sdk-sync": "node ../packages/image-url/scripts/sync.js"
  },
  "dependencies": {
    "@aws-sdk/client-application-auto-scaling": "^3.1150.0",
    "@aws-sdk/client-cloudwatch": "^3.1118.0",
    "@aws-sdk/client-ecs": "^3.1098.0",
    "@aws-sdk/client-firehose": "^3.1150.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-sns": "^3.1151.0",
    "argon2": "^0.40.3",
    "@node-saml/node-saml": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exifr": "^7.1.3",
    "express": "^4.19.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "rrule": "^2.8.1",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3"
  }
}
