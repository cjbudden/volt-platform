                  "pm.test('defines hydra and schema.org', () => { pm.expect(c).to.have.property('hydra'); pm.expect(c).to.have.property('schema'); });",
                  "pm.collectionVariables.set('vocabUrl', c.volt);",
                  "console.log('vocabulary namespace: ' + c.volt);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/channels — the collection",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/channels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "channels"
              ]
            },
            "description": "Followed from the entry point. Only carries ids and links when ld+json is asked for."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('is a Hydra Collection', () => pm.expect(JSON.stringify(b['@type'])).to.include('Collection'));",
                  "pm.test('reports totalItems', () => pm.expect(b).to.have.property('hydra:totalItems'));",
                  "const m = b['hydra:member'] || [];",
                  "pm.test('members carry @id', () => pm.expect(m[0]).to.have.property('@id'));",
                  "if (m[0]) { pm.collectionVariables.set('channelUrl', m[0]['@id']); pm.collectionVariables.set('channelId', m[0].id);",
                  "  console.log('link relations on a member: ' + Object.keys(m[0]).filter(k => typeof m[0][k]==='string' && m[0][k].startsWith('http')).join(', ')); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/channels?limit=1 — paging and siblings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/channels?limit=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "channels"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            },
            "description": "Followed from the entry point. Only carries ids and links when ld+json is asked for."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('a hydra:Collection', () => pm.expect(b['@type']).to.equal('hydra:Collection'));",
                  "pm.test('totalItems counts every match', () => pm.expect(b['hydra:totalItems']).to.be.at.least(b['hydra:member'].length));",
                  "pm.test('view has first', () => pm.expect(b['hydra:view'].first).to.be.a('string'));",
                  "if (b['hydra:totalItems'] > 1) pm.test('view has next (cursor)', () => pm.expect(b['hydra:view'].next).to.include('cursor='));",
                  "pm.test('filters published as an IriTemplate', () => pm.expect(b['hydra:search']['@type']).to.equal('hydra:IriTemplate'));",
                  "pm.test('breadcrumb starts at the entry point', () => pm.expect(b.breadcrumb[0]['@id']).to.match(/\\/api$/));"
                ]
              }
            }
          ]
        },
