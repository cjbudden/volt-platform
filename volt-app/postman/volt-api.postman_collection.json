              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the endpoint works', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));",
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.test('JSON-LD decorated: carries @id', () => pm.expect(!!(b && b['@id'])).to.equal(true));",
                  "  pm.test('walks up and has a breadcrumb', () => { pm.expect(b.up || b.collection).to.be.a('string'); pm.expect(b.breadcrumb).to.be.an('array'); });",
                  "}"
                ]
              }
