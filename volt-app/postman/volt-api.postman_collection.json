            "url": {
              "raw": "{{baseUrl}}/api/status/channel/{{channelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "status",
                "channel",
                "{{channelId}}"
              ]
            },
            "description": "Linked from every channel. Returns 404 when the channel has never run, rather than an empty status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the old per-stream URL is a 404 until the stream has run', () => pm.expect(pm.response.code).to.be.oneOf([200,404]));",
                  "pm.sendRequest({ url: pm.environment.get('baseUrl') + '/api/channels/' + pm.environment.get('channelId'), header: { accept: 'application/ld+json', authorization: 'Bearer ' + pm.environment.get('token') } }, (e, r) => {",
                  "  pm.test('the channel now links its status as the filtered status collection', () => pm.expect(r.json().status).to.include('/api/status?channelId='));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
