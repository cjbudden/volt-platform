{
  "info": {
    "_postman_id": "volt-api-navigability-2026-09-04",
    "name": "VOLT API — navigability walk",
    "description": "The main, full collection (public, admin and platform APIs, every request with a live example) is api/Volt.postman_collection.json; see docs/API_GUIDE.md. This one is a separate experiment: the hypermedia navigability walk. It signs in as an admin user without two-step sign-in (a user with it on gets a challenge, not a token).\n\nRuns the API the way a client with no documentation would: start at /api and only\nfollow links that appear in responses.\n\nIMPORTANT: the hypermedia layer is CONTENT NEGOTIATED. Without\n\"Accept: application/ld+json\" every collection returns a bare JSON array with no\nlinks and no ids. That header is set at collection level here. Remove it and\nfolder 2 stops working, which is itself one of the findings.\n\nFolder 4 documents defects on purpose: those requests are expected to fail, and\ntheir tests assert the failure so the collection turns green when they are fixed\nand stays honest until then.\n\nRun with: newman run volt-api.postman_collection.json -e volt-local.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 · Sign in",
      "item": [
        {
          "name": "Login (captures {{token}})",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "The one thing discovery cannot give you: the entrypoint does not link to auth, so every client needs this URL out of band.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('returns an access token', () => pm.expect(b).to.have.property('access'));",
                  "pm.environment.set('token', b.access); pm.collectionVariables.set('token', b.access);",
                  "pm.test('DEFECT: entrypoint does not advertise the auth endpoint', () => pm.expect(true).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 · Discovery walk (links only)",
      "item": [
        {
          "name": "GET /api — the entry point",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api"
              ]
            },
            "description": "The service document. This is the WSDL-equivalent starting point."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('is a Hydra EntryPoint', () => pm.expect(JSON.stringify(b['@type'])).to.include('EntryPoint'));",
                  "pm.test('links to the API documentation', () => pm.expect(b).to.have.property('apiDocumentation'));",
                  "const cols = Object.keys(b).filter(k => !k.startsWith('@') && k !== 'apiDocumentation');",
                  "console.log('collections advertised: ' + cols.length + ' -> ' + cols.join(', '));",
                  "pm.test('advertises at least 10 collections', () => pm.expect(cols.length).to.be.at.least(10));",
                  "pm.collectionVariables.set('channelsUrl', b.channels);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/doc — supported classes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/doc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doc"
              ]
            },
            "description": "Where a WSDL would describe operations and types."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "const cls = b['hydra:supportedClass'] || [];",
                  "console.log('classes described: ' + cls.length);",
                  "const ops = cls.reduce((n,c) => n + ((c['hydra:supportedOperation']||c.supportedOperation||[]).length), 0);",
                  "const props = cls.reduce((n,c) => n + ((c['hydra:supportedProperty']||c.supportedProperty||[]).length), 0);",
                  "console.log('operations described: ' + ops + ' · properties described: ' + props);",
                  "pm.test('DEFECT: classes are named but carry no operations', () => pm.expect(ops).to.equal(0));",
                  "pm.test('DEFECT: classes are named but carry no properties', () => pm.expect(props).to.equal(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/context.jsonld",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/context.jsonld",
              "host": [
