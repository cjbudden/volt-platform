    {
      "name": "3 · Reached from the entry point (fixed 20 Oct 2026)",
      "description": "These used to return 200 but could not be found by following links, and were never JSON-LD decorated. Since 20 Oct 2026 every list endpoint is a hydra:Collection, the entry point links every top-level collection, and every other answer under /api carries an @id, an up link and a breadcrumb. Each request asserts that.",
      "item": [
        {
          "name": "Radio stations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
