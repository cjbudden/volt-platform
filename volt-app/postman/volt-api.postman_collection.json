                  "const b = pm.response.json();",
                  "pm.test('is a decorated collection', () => pm.expect(b).to.have.property('hydra:member'));",
                  "pm.test('DEFECT: an empty collection emits no onward links, so the walk stops here', () => pm.expect(b['hydra:totalItems']).to.equal(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/vod \u2014 and its schema.org projection",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/vod",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vod"
              ]
            },
            "description": "The best-linked resource in the API: members link to publications and to a schema.org VideoObject."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const m = pm.response.json()['hydra:member'] || [];",
                  "if (m[0]) { pm.collectionVariables.set('vodId', m[0].id);",
                  "  pm.test('a VoD member links to its schema.org projection', () => pm.expect(m[0]).to.have.property('schemaOrg')); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/vod/:id/schema.org",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/vod/{{vodId}}/schema.org",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vod",
                "{{vodId}}",
                "schema.org"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('is a schema.org media type', () => pm.expect(['Clip','VideoObject','BroadcastEvent']).to.include(b['@type']));",
                  "pm.test('carries an embedUrl a search engine can use', () => pm.expect(b).to.have.property('embedUrl'));",
                  "pm.test('a Clip declares its offsets into the parent work', () => { if (b['@type']==='Clip') { pm.expect(b).to.have.property('startOffset'); pm.expect(b).to.have.property('endOffset'); } });",
                  "pm.test('offers both HLS and DASH as associatedMedia', () => { const f=(b.associatedMedia||[]).map(m=>m.encodingFormat); pm.expect(f).to.include('application/vnd.apple.mpegurl'); pm.expect(f).to.include('application/dash+xml'); });",
                  "pm.test('offers a WatchAction', () => pm.expect(b.potentialAction && b.potentialAction['@type']).to.equal('WatchAction'));"
                ]
              }
            }
          ]
        }
      ]
    },
