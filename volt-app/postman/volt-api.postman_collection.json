    {
      "name": "4 · Formerly broken links (fixed 20 Oct 2026)",
      "description": "These URLs came out of the API's own responses during the September link walk and failed when followed. Each test now asserts the fix: scoped collections are IriTemplates, the volt: vocabulary is /api/doc, actions are declared as POST operations, and a stream's status link answers 200 before it has ever run.",
      "item": [
        {
          "name": "Entry point → /api/publications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/publications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "publications"
              ]
            },
            "description": "The entry point advertises this collection. Fetching it without a query parameter is a 400, so the advertised link is not followable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the bare collection still needs its scope (400)', () => pm.response.to.have.status(400));",
                  "pm.sendRequest({ url: pm.environment.get('baseUrl') + '/api', header: { accept: 'application/ld+json' } }, (e, r) => {",
                  "  pm.test('the entry point offers it as an IriTemplate, not a link', () => pm.expect(r.json().publications['@type']).to.equal('hydra:IriTemplate'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Context → the volt: vocabulary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/vocab",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vocab"
              ]
            },
            "description": "context.jsonld declares the volt: namespace at /api/vocab#. Nothing is served there, so every volt: term in the API is undereferenceable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('/api/vocab is not the vocabulary (404)', () => pm.response.to.have.status(404));",
                  "pm.sendRequest({ url: pm.environment.get('baseUrl') + '/api/context.jsonld' }, (e, r) => {",
                  "  pm.test('volt: resolves to the ApiDocumentation', () => pm.expect(r.json()['@context'].volt).to.match(/\\/api\\/doc#$/));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Channel → start",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/channels/{{channelId}}/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "channels",
                "{{channelId}}",
                "start"
              ]
            },
            "description": "The channel representation links to this URL but never says which method it takes. It is POST-only, so a client that follows the link with GET gets a 404. This is the WSDL gap in one request: a link with no operation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GET on an action is still a 404', () => pm.response.to.have.status(404));",
                  "pm.sendRequest({ url: pm.environment.get('baseUrl') + '/api/doc' }, (e, r) => {",
                  "  const ch = r.json()['hydra:supportedClass'].find((c) => c['@id'] === 'volt:Channel');",
                  "  pm.test('the doc declares POST /channels/{id}/start', () => pm.expect(ch['hydra:supportedOperation'].some((o) => o['hydra:method'] === 'POST' && /\\/start$/.test(o.target))).to.equal(true));",
                  "});"
                ]
              }
            }
          ]
        },
        {
