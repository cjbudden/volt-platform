    {
      "name": "4 \u00b7 Broken links the API itself emits",
      "description": "These URLs came out of the API's own responses during a link walk. Following them fails. Each test asserts the CURRENT broken behaviour, so it fails loudly once fixed.",
      "item": [
        {
          "name": "Entry point \u2192 /api/publications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/publications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "publications"
              ]
            },
            "description": "The entry point advertises this collection. Fetching it without a query parameter is a 400, so the advertised link is not followable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('DEFECT: advertised collection returns 400', () => pm.response.to.have.status(400));",
                  "console.log(pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "Context \u2192 the volt: vocabulary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/vocab",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vocab"
              ]
            },
            "description": "context.jsonld declares the volt: namespace at /api/vocab#. Nothing is served there, so every volt: term in the API is undereferenceable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('DEFECT: the declared vocabulary namespace 404s', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Channel \u2192 start",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/channels/{{channelId}}/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "channels",
                "{{channelId}}",
                "start"
              ]
            },
            "description": "The channel representation links to this URL but never says which method it takes. It is POST-only, so a client that follows the link with GET gets a 404. This is the WSDL gap in one request: a link with no operation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('DEFECT: linked action 404s on GET because the method is not declared', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Channel \u2192 status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/ld+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/status/channel/{{channelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "status",
                "channel",
                "{{channelId}}"
              ]
            },
            "description": "Linked from every channel. Returns 404 when the channel has never run, rather than an empty status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('linked status is either a document or a 404', () => pm.expect(pm.response.code).to.be.oneOf([200,404]));",
                  "pm.test('DEFECT: status is never JSON-LD decorated', () => { const b = pm.response.json(); pm.expect(!!(b && b['@id'])).to.equal(false); });"
                ]
              }
            }
          ]
        }
      ]
    }
