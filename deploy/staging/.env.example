# Copy to .env and fill in. Never commit .env.
#
# openssl rand -hex 32   gives a good value for each secret.

POSTGRES_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Optional. Signs playback tokens separately from operator sessions.
PLAYBACK_TOKEN_SECRET=
# Signs public-user (viewer) sessions. Leave blank to derive one from JWT_ACCESS_SECRET.
VIEWER_JWT_SECRET=
INGEST_TOKEN=change-me-ingest
# Seals authenticator-app seeds. 32 bytes: openssl rand -base64 32. Blank = derived from JWT_ACCESS_SECRET.
# Keep it once set: changing it means everyone sets their authenticator app up again.
MFA_ENCRYPTION_KEY=

# Email for sign-in codes and email changes. Blank = the mailpit catcher (http://<host>:8025).
# For real mail, e.g. Amazon SES: smtps://USER:PASS@email-smtp.ap-southeast-2.amazonaws.com:465
SMTP_URL=
NOTIFY_FROM=volt@staging.local
# Text-message codes: sns (needs AWS credentials with sns:Publish) or blank (SMS codes not offered).
SMS_PROVIDER=
SMS_SENDER_ID=
# The edge proves requests came through it with this (geo header trust).
EDGE_SHARED_SECRET=change-me-edge

# What viewers and operators type in the browser.
PUBLIC_BASE_URL=http://staging.example.internal
EDGE_PORT=80

# Shape of the deployment.
PUBLIC_REPLICAS=2
SCHEDULER_REPLICAS=1
WORKER_REPLICAS=1
WORKER_CONCURRENCY=2

# mock = no real encoders; docker = real encoder containers (mount the socket in docker-compose.yml).
ORCH_LAUNCHER=mock

ICECAST_SOURCE_PASSWORD=change-me-icecast
ICECAST_ADMIN_PASSWORD=change-me-icecast-admin
ICECAST_AUTH_SECRET=change-me-relay
